{
  "name": "vello-provider-card",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Vello ProviderCard — Round Robin Friday deliverable (Engineering track)",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
